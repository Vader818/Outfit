{
  "name": "outfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "privacy:clean": "node scripts/privacy-clean.mjs",
    "models:status": "node scripts/models.mjs status",
    "models:download:rembg": "node scripts/models.mjs download rembg",
    "models:download:clip": "node scripts/models.mjs download clip",
    "models:verify": "node scripts/models.mjs verify all",
    "build": "tsc -p tsconfig.json && vite build"
  },
  "engines": {
    "node": ">=24.14 <27"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "express": "^5.1.0",
    "helmet": "^8.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.2",
    "daisyui": "^5.5.23",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
